---
/**
 * s3–s5 — Timeline with scattered-polaroid collage.
 * Original positions photos freely (rotated ±11–34°, overlapping, some
 * bleeding off-canvas) — not a grid. Positions/tilts come from data.
 */
import type { Timeline } from "../data/site";

interface Props {
    timeline: Timeline;
}
const { timeline } = Astro.props;
const { years, headline, bg, photos } = timeline;
---

<section
    class:list={["section", bg === "cream" ? "bg-cream" : "bg-white"]}
    data-headline={headline}
>
    <div class="relative w-full max-w-6xl">
        {/* Year chips across the top */}
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-2">
            {
                years.map((y) => (
                    <span class="font-display text-[clamp(1.1rem,1.7vw,1.667rem)] text-black/80">
                        {y}
                    </span>
                ))
            }
        </div>

        {/* Collage box: polaroids positioned in % so the scatter scales */}
        <div
            class="relative mx-auto mt-4 aspect-[16/10] w-full sm:aspect-[16/9]"
        >
            {
                photos.map((p) => (
                    <figure
                        class="polaroid w-[30%] max-w-[340px]"
                        style={`left:${p.x}%; top:${p.y}%; width:${p.w}%; transform:rotate(${p.rot}deg); z-index:${p.z ?? 1}`}
                    >
                        <img src={p.src} alt={p.alt} loading="lazy" />
                    </figure>
                ))
            }
        </div>

        {/* Drop-cap headline */}
        <h2
            class="font-body-bn mt-2 text-center text-[clamp(1.6rem,4vw,3.333rem)] font-bold text-olive"
        >
            <span class="text-gold drop-shadow-[0_1px_0_rgba(0,0,0,0.15)]"
                >{headline.slice(0, 1)}</span
            >
            {headline.slice(1)}
        </h2>
    </div>
</section>
