---
/**
 * s6 — Ornament band. Original: olive-green page with decorative PNGs and
 * the animated GIF ornament (740×580) as the centerpiece.
 */
import { ornament } from "../data/site";
---

<section class="section bg-olive" id="ornament">
    <div class="flex items-center justify-center gap-4 opacity-90 sm:gap-8">
        <img
            src="/images/ornament-2.png"
            alt=""
            aria-hidden="true"
            class="hidden h-16 w-40 object-contain md:block lg:h-20 lg:w-52"
            loading="lazy"
        />
        <img
            src={ornament.gif}
            alt=""
            aria-hidden="true"
            class="h-56 w-auto object-contain sm:h-72 lg:h-80"
            loading="lazy"
        />
        <img
            src="/images/ornament-2.png"
            alt=""
            aria-hidden="true"
            class="hidden h-16 w-40 scale-x-[-1] object-contain md:block lg:h-20 lg:w-52"
            loading="lazy"
        />
    </div>
</section>
