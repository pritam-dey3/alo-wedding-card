---
/**
 * s8 — Family / পরিচিতি. Olive page, two side-by-side blocks
 * (পাত্র / পাত্রী) with divider ornaments.
 */
import { family } from "../data/site";
---

<section class="section bg-olive text-white" id="family">
    <div class="w-full max-w-5xl">
        <h2
            class="font-body-bn text-center text-[clamp(1.3rem,2.6vw,2.667rem)]"
        >
            {family.title}
        </h2>

        <div class="mt-10 grid gap-10 md:grid-cols-2">
            {
                [family.groom, family.bride].map((person, i) => (
                    <div class="relative">
                        <img
                            src={
                                i === 0
                                    ? "/images/family-divider-2.png"
                                    : "/images/bride.png"
                            }
                            alt=""
                            aria-hidden="true"
                            class:list={[
                                "pointer-events-none absolute -top-10 h-20 w-auto opacity-30",
                                i === 0 ? "-left-6" : "-right-6 scale-x-[-1]",
                            ]}
                            loading="lazy"
                        />
                        <ul class="font-body-bn space-y-2 text-[clamp(1rem,1.7vw,2.043rem)] leading-relaxed">
                            {person.lines.map((line) => (
                                <li>{line}</li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>
