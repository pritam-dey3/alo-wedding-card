---
/**
 * s0 — Hero. Original: cream-green page, white inner card, couple photos
 * at left/right edges, centered heading stack. (REGISTER HERE / English
 * Card buttons dropped per scope.)
 */
import { hero } from "../data/site";
---

<section class="section bg-cream" id="hero">
    {/* White card frame */}
    <div
        class="relative flex min-h-[70svh] w-full max-w-6xl flex-col items-center justify-center border border-olive/10 bg-white px-6 py-14 shadow-sm"
    >
        {/* Couple photos pinned to the card corners, like the original */}
        <img
            src="/images/groom.png"
            alt="গৌরব"
            class="absolute bottom-6 left-4 hidden h-56 w-auto object-contain sm:block lg:left-8 lg:h-72"
        />
        <img
            src="/images/bride.png"
            alt="রূপকথা"
            class="absolute -top-6 right-4 hidden h-56 w-auto object-contain sm:block lg:right-8 lg:h-72"
        />

        <div class="text-center">
            <p
                class="font-hero text-[clamp(1.75rem,4vw,3.5rem)] leading-tight text-gold drop-shadow-sm"
            >
                {hero.overline}
            </p>
            <h1
                class="font-display mt-2 text-[clamp(3rem,9vw,8.333rem)] leading-none text-olive"
            >
                {hero.title}
            </h1>
            <p
                class="font-body-bn mt-6 text-[clamp(1rem,2.2vw,2.083rem)] font-normal tracking-wide text-olive/90"
            >
                {hero.line1}
            </p>
            <p
                class="font-body-bn mt-1 text-[clamp(1.1rem,2.4vw,2.333rem)] font-medium text-gold"
            >
                {hero.line2}
            </p>
        </div>
    </div>
</section>
