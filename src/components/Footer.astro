---
/**
 * 4 — Footer. A closing note.
 */
import { footer } from "../data/site";
import { flourish } from "../data/kolka";
import BorderRule from "./BorderRule.astro";
import Kolka from "./Kolka.astro";
---

<footer class="section panel-dark text-center" id="footer">
    {/* Rises out of the story's deep cream — the seam is a gradient. */}
    <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-20 bg-gradient-to-b from-cream-2 to-transparent sm:h-28"
        aria-hidden="true"
    >
    </div>

    {/* Corner sprays; wrappers own the flips so GSAP can sway the inner
        svgs. A wide cloud of curls crowns the rule. */}
    <div class="absolute bottom-0 left-0 -scale-y-100" aria-hidden="true">
        <Kolka
            art={flourish(13)}
            class="w-[clamp(7rem,14vw,12rem)] text-gold-2 opacity-25"
        />
    </div>
    <div class="absolute bottom-0 right-0 -scale-100" aria-hidden="true">
        <Kolka
            art={flourish(13)}
            class="w-[clamp(7rem,14vw,12rem)] text-gold-2 opacity-25"
        />
    </div>
    <div
        class="absolute left-1/2 top-4 -translate-x-1/2 sm:top-6"
        aria-hidden="true"
    >
        <Kolka
            art={flourish(11)}
            class="w-24 text-gold-2 opacity-25 sm:w-40"
        />
    </div>
    <div class="relative flex w-full max-w-xl flex-col items-center">
        <BorderRule class="reveal w-40 text-gold-2 opacity-55 sm:w-52" />

        <p
            class="reveal mt-6 max-w-sm font-body-bn text-sm leading-relaxed text-gold-3/60"
        >
            {footer.note}
        </p>
    </div>
</footer>
